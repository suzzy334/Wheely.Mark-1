GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#830)) GLOBAL_UNIT_ASSIGNED_CONTEXT
((#827,#828,#829)) REPRESENTATION_CONTEXT('Context #1',
  '3D Context with UNIT and UNCERTAINTY') );
#827 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#828 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#829 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#830 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#827,
  'distance_accuracy_value','confusion accuracy');
#831 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#7));
